{
  "name": "argus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\"",
    "dev:landing": "vite",
    "build:landing": "vite build",
    "copy:landing": "node scripts/copy-landing.cjs",
    "build:frontend": "npm run build --prefix frontend",
    "merge:landing": "node scripts/merge-build.cjs",
    "install:backend": "npm install --production --legacy-peer-deps --prefix backend",
    "install:frontend": "npm install --production --legacy-peer-deps --prefix frontend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build:landing && npm run copy:landing && npm run build:frontend && node scripts/merge-build.cjs",
    "start:backend": "NODE_ENV=production npm run start --prefix backend",
    "start:frontend": "NODE_ENV=production npm run start --prefix frontend",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "cpanel:install": "npm install --production --legacy-peer-deps && npm run install:backend",
    "cpanel:deploy": "npm run cpanel:install",
    "cpanel:start:backend": "cd backend && node server.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.12"
  },
  "devDependencies": {},
  "overrides": {
    "postcss": "^8.5.10",
    "tmp": "^0.2.6",
    "uuid": "^14.0.0",
    "glob": "^10.5.0",
    "fast-csv": "^4.3.6"
  }
}
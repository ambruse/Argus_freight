# ================================================================
#  ARGUS Backend — cPanel Environment Variables
#  Copy this file to backend/.env and fill in your real values.
#  DO NOT commit the real .env file to git.
# ================================================================

# ─── MySQL Database (from cPanel → MySQL Databases) ──────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=argusship_db
DB_PASSWORD=IdKua?2)WEk!cblw
DB_NAME=freight_rfq

# ─── JWT Security ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=8h

# ─── Server ───────────────────────────────────────────────────
# cPanel Passenger sets PORT automatically — leave this blank
# or set to your Node.js App port from cPanel (usually 3001)
PORT=3001
NODE_ENV=production

# ─── CORS: your actual domain ────────────────────────────────
CLIENT_URL=https://argusshipping.co

# ─── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Email (SMTP for sending) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ─── Email (IMAP for receiving) ──────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password_here

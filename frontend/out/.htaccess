Options -Indexes
RewriteEngine On

# ── SEO 301 Redirects for Legacy URLs ───────────────────────
RewriteRule ^services/(.+)-qatar/?$ /services/$1/ [R=301,L]
RewriteRule ^shipping/(.+)-to-qatar/?$ /trade-lanes/$1-to-qatar/ [R=301,L]
RewriteRule ^shipping/?$ /trade-lanes/ [R=301,L]

# Preserve the existing /services hub despite the new child-page directory.
RewriteRule ^services/$ /services [R=301,L]
RewriteRule ^services$ services.html [L]

# Existing clean public URLs resolve to their prerendered HTML files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ── Serve real static files directly (CSS, JS, images) ───────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Gzip compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
